	@echo "... src/server/SearchEngineServer.s"
	@echo "... src/server/WebSearch.o"
	@echo "... src/server/WebSearch.i"
	@echo "... src/server/WebSearch.s"
	@echo "... src/server/main.o"
	@echo "... src/server/main.i"
	@echo "... src/server/main.s"
